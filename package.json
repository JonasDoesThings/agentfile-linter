{
  "name": "agentfile-linter",
  "version": "0.0.1-rc.2",
  "description": "Linter for AI agent context files (AGENTS.md, CLAUDE.md, GEMINI.md, ...)",
  "bin": {
    "agentfile-linter": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/types",
    "docs/plugin-api.md",
    "configuration_schema.json"
  ],
  "type": "module",
  "types": "./dist/types/plugin-types.d.ts",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*",
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/types/plugin-types.d.ts"
    },
    "./package.json": "./package.json",
    "./docs/plugin-api.md": "./docs/plugin-api.md"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "build:npm": "bun run scripts/build-npm.ts",
    "prepack": "bun run build:npm",
    "schema": "bun run scripts/generate-schema.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint:self": "bun run src/cli.ts .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test && bun run lint:self"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "esquery": "^1.6.0",
    "github-slugger": "^2.0.0",
    "ignore": "^7.0.16",
    "jsonc-parser": "^3.3.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "minimatch": "^11.0.9",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/markdown": "^9.0.0",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "^1.4.5",
    "@types/esquery": "^1.5.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
