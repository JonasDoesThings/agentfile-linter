{
  // Emits the declarations of the types for plugin authors (see `scripts/build-npm.ts`).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": ["node"]
  },
  "include": [],
  "files": ["src/plugin-types.ts"]
}
